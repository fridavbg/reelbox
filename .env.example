# Variables are added here as features need them (database, auth, email).

# Neon Postgres connection string (Neon console → Connect → pooled connection).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Direct (unpooled) connection to the same database, for Prisma migrations.
# Same string as above without "-pooler" in the host name.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Signs session cookies and hashes sign-in codes. At least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's own URL. Used when a request comes from a host that isn't allowed.
BETTER_AUTH_URL=http://localhost:3000

# Brevo sends the sign-in emails (brevo.com → SMTP & API → API keys).
# Leave both empty locally: sign-in codes are then printed in the terminal.
BREVO_API_KEY=
EMAIL_FROM=
